# Shell and Python must keep LF endings even when cloned on Windows (bash in WSL fails on CRLF).
*.sh   text eol=lf
*.py   text eol=lf
*.service text eol=lf
Caddyfile text eol=lf
*.plan text eol=lf
*.env.example text eol=lf
# Windows launchers need CRLF.
*.bat  text eol=crlf
*.ps1  text eol=crlf
*.md   text
