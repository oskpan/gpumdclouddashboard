# Per-PC settings read by start_wsl.sh. Copy to hub.env (same folder), fill in, then:  chmod 600 hub.env
# hub.env is git-ignored: it holds this PC's secret token. Never commit it.
#
# Hub connection (leave these three out to run gpumdq locally only):
GPUMDQ_HUB=https://YOUR.SERVER.IP.OR.DOMAIN
GPUMDQ_HUB_TOKEN=paste-the-token-from-add-host-here
GPUMDQ_NAME=PC1
# GPUMDQ_PUSH_EVERY=10
#
# GPUMD on THIS PC (defaults in start_wsl.sh; the binary must be named gpumd):
# GPUMD_BIN=/home/<user>/GPUMD/src/gpumd
# GPUMD_LIB=/home/<user>/miniconda3/envs/gpumd/lib
